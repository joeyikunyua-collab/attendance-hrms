# Must match the JWT_SECRET used by the api/ app - middleware.ts verifies
# the session cookie locally (no DB round trip) for page-route gating.
JWT_SECRET=replace-this-with-a-long-random-string

# Base URL of the standalone Express API (see ../api). Used server-side only,
# by next.config.js's rewrite of /api/* - never exposed to the browser.
API_URL=http://localhost:4001
