# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/attendance

# Secret used to sign login session tokens (use a long random string) - must
# match the JWT_SECRET used by the admin app's middleware.ts
JWT_SECRET=replace-this-with-a-long-random-string

# Port the Express server listens on
PORT=4001

# Credentials used only by the one-time admin seed script (npm run seed:admin)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Administrator
